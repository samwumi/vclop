# Production Environment Variables Template
# Copy this file and fill in your production values
# DO NOT commit actual production values to git!

# ============================================
# DATABASE
# ============================================
DATABASE_URL="mysql://username:password@host:3306/vclop"

# ============================================
# SECURITY
# ============================================
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_MIN_32_CHARS
SEED_ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ============================================
# APPLICATION
# ============================================
FRONTEND_URL=https://verticalcapital.ng
NODE_ENV=production
PORT=3000

# ============================================
# FILE STORAGE (CRITICAL - NEW)
# ============================================
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL=https://api.verticalcapital.ng/uploads

# ============================================
# EMAIL (SMTP)
# ============================================
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_NAME=Vertical Capital
MAIL_FROM_EMAIL=noreply@verticalcapital.ng

# ============================================
# OPTIONAL: AWS S3 (if using S3 storage)
# ============================================
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
