enum ContractType {
  PERMANENT
  CONTRACT
  PROBATION
  INTERN
  CONSULTANT
}

enum TerminationType {
  RESIGNATION
  TERMINATION
  RETIREMENT
  CONTRACT_END
  DEATH
  ABSCONDING
  MUTUAL_SEPARATION
}

enum DayType {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum LeaveStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  ESCALATED
  EXPIRED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  RETURN_FOR_INFO
  ESCALATE
}

enum PolicyEntityType {
  LEAVE_APPLICATION
  STAFF_LOAN
  RESOURCE_ASSIGNMENT
}

enum StaffLoanInterestType {
  FLAT
  REDUCING
  SIMPLE
}

enum StaffLoanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISBURSED
  ACTIVE
  COMPLETED
  WRITTEN_OFF
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  SALARY_DEDUCTION
  BANK_TRANSFER
  CASH
  CHEQUE
  MOBILE_MONEY
}

enum ReversalReason {
  DUPLICATE_PAYMENT
  INCORRECT_AMOUNT
  WRONG_LOAN_ACCOUNT
  EMPLOYEE_REQUEST
  BANK_ERROR
  SYSTEM_ERROR
  FRAUD_INVESTIGATION
  OTHER
}

enum AdjustmentType {
  INTEREST_WAIVER
  PENALTY_CHARGE
  LATE_FEE
  PRINCIPAL_WRITEOFF
  GOODWILL_CREDIT
  CORRECTION
}

enum ResourceType {
