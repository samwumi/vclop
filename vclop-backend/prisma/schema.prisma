  UNMATCHED
  RECONCILED
}

enum WorkflowTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum WorkflowAction {
  APPROVE
  REJECT
  RETURN
  REQUEST_INFORMATION
  ESCALATE
  COMPLETE
}

enum TransportRequestStatus {
  PENDING
  OPERATIONS_REVIEW
  APPROVED
  REJECTED
  PAID
  COMPLETED
  CANCELLED
}

enum CollectionCaseStatus {
  OPEN
  PROMISE_TO_PAY
  BROKEN_PROMISE
  LEGAL
  RESOLVED
  WRITTEN_OFF
}

model OtpCode {
