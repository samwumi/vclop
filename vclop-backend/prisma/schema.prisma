generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Branch {
  id               String            @id @default(uuid()) @db.VarChar(36)
  code             String            @unique @db.VarChar(20)
  name             String            @db.VarChar(100)
  address          String?           @db.VarChar(500)
  city             String?           @db.VarChar(100)
  state            String?           @db.VarChar(100)
  country          String            @default("Philippines") @db.VarChar(100)
  postalCode       String?           @db.VarChar(20)
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  phone            String?           @db.VarChar(30)
  email            String?           @db.VarChar(150)
  managerName      String?           @db.VarChar(150)
  isHeadOffice     Boolean           @default(false)
  isActive         Boolean           @default(true)
  metadata         String?           @db.LongText
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  auditLogs        AuditLog[]
  settings         Setting[]
  managedByUsers   UserBranch[]
  users            User[]
  recoveryAccounts RecoveryAccount[]

  // HR Module Relations
  employmentPeriods EmploymentPeriod[] @relation("PeriodBranch")
  publicHolidays    PublicHoliday[]    @relation("HolidayBranch")
  workweeks         BranchWorkweek[]   @relation("WorkweekBranch")

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("branches")
}

model Department {
  id          String       @id @default(uuid()) @db.VarChar(36)
  code        String       @unique @db.VarChar(20)
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(500)
  parentId    String?      @db.VarChar(36)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  metadata    String?      @db.LongText
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  users       User[]

  // HR Module Relations
  employmentPeriods EmploymentPeriod[] @relation("PeriodDepartment")

  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("departments")
}

model Permission {
  id              String             @id @default(uuid()) @db.VarChar(36)
  code            String             @unique @db.VarChar(100)
  name            String             @db.VarChar(150)
  description     String?            @db.VarChar(500)
  category        PermissionCategory
  module          String             @db.VarChar(50)
  action          String             @db.VarChar(50)
  isSystem        Boolean            @default(false)
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([code])
  @@index([category])
  @@index([module])
  @@index([isActive])
  @@map("permissions")
}

model Role {
  id              String           @id @default(uuid()) @db.VarChar(36)
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(500)
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  metadata        String?          @db.LongText
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.VarChar(36)
  roleId       String     @db.VarChar(36)
  permissionId String     @db.VarChar(36)
  createdAt    DateTime   @default(now())
  createdById  String?    @db.VarChar(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                       String                   @id @default(uuid()) @db.VarChar(36)
  employeeId               String?                  @unique @db.VarChar(30)
  email                    String                   @db.VarChar(150)
  phone                    String?                  @db.VarChar(30)
  username                 String                   @db.VarChar(50)
  passwordHash             String                   @db.VarChar(255)
  firstName                String                   @db.VarChar(80)
  middleName               String?                  @db.VarChar(80)
  lastName                 String                   @db.VarChar(80)
  suffix                   String?                  @db.VarChar(20)
  gender                   Gender?
  dateOfBirth              DateTime?                @db.Date
  avatarPath               String?                  @db.VarChar(500)
  status                   UserStatus               @default(PENDING_VERIFICATION)
  departmentId             String?                  @db.VarChar(36)
  branchId                 String?                  @db.VarChar(36)
  supervisorId             String?                  @db.VarChar(36)
  jobTitle                 String?                  @db.VarChar(100)
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  lastLoginIp              String?                  @db.VarChar(45)
  failedLoginCount         Int                      @default(0)
  lockedUntil              DateTime?
  mustChangePassword       Boolean                  @default(false)
  twoFactorEnabled         Boolean                  @default(false)
  twoFactorSecret          String?                  @db.VarChar(255)
  timezone                 String                   @default("Asia/Manila") @db.VarChar(50)
  locale                   String                   @default("en-PH") @db.VarChar(10)
  metadata                 String?                  @db.LongText
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deletedAt                DateTime?
  createdById              String?                  @db.VarChar(36)
  updatedById              String?                  @db.VarChar(36)
  auditLogs                AuditLog[]
  dashboardLayouts         DashboardLayout[]
  notificationPreferences  NotificationPreference[]
  tokens                   Token[]
  otpCodes                 OtpCode[]
  managedBranches          UserBranch[]
  userPermissions          UserPermission[]
  userRoles                UserRole[]
  branch                   Branch?                  @relation(fields: [branchId], references: [id])
  department               Department?              @relation(fields: [departmentId], references: [id])
  supervisor               User?                    @relation("UserHierarchy", fields: [supervisorId], references: [id])
  subordinates             User[]                   @relation("UserHierarchy")
  targets                  OfficerTarget[]          @relation("OfficerTargets")
  recoveryAccountsAssigned RecoveryAccount[]        @relation("RecoveryOfficer")
  recoveryAccountsCreated  RecoveryAccount[]        @relation("RecoveryAccountCreator")
  recoveryActivities       RecoveryActivity[]       @relation("ActivityRecorder")
  recoveryPaymentsRecorded RecoveryPayment[]        @relation("PaymentRecordedBy")
  recoveryPaymentsVerified RecoveryPayment[]        @relation("PaymentVerifiedBy")
  repaymentPromises        RepaymentPromise[]       @relation("PromiseRecorder")
  recoveryDocuments        RecoveryDocument[]       @relation("RecoveryDocUploader")
  recoveryExpenses         RecoveryExpense[]        @relation("ExpenseRecorder")

  // HR Module Relations
  employmentPeriods            EmploymentPeriod[]           @relation("EmploymentPeriods")
  employmentPeriodsCreated     EmploymentPeriod[]           @relation("EmploymentPeriodCreator")
  leaveEntitlements            LeaveEntitlement[]           @relation("LeaveEntitlements")
  leaveEntitlementsCreated     LeaveEntitlement[]           @relation("EntitlementCreator")
  leaveEntitlementsUpdated     LeaveEntitlement[]           @relation("EntitlementUpdater")
  leaveAdjustmentsApproved     LeaveEntitlementAdjustment[] @relation("AdjustmentApprover")
  leaveApplications            LeaveApplication[]           @relation("LeaveApplications")
  leaveApplicationsSubmitted   LeaveApplication[]           @relation("LeaveSubmitter")
  leaveApplicationsApproved    LeaveApplication[]           @relation("LeaveApprover")
  leaveApplicationsRejected    LeaveApplication[]           @relation("LeaveRejecter")
  leaveApplicationsCancelled   LeaveApplication[]           @relation("LeaveCanceller")
  leaveApprovalsAsApprover     LeaveApproval[]              @relation("LeaveApproverUser")
  leaveApprovalsAsDelegator    LeaveApproval[]              @relation("LeaveApprovalDelegator")
  staffLoans                   StaffLoan[]                  @relation("StaffLoanBorrower")
  staffLoansCreated            StaffLoan[]                  @relation("StaffLoanCreator")
  staffLoansSubmitted          StaffLoan[]                  @relation("StaffLoanSubmitter")
  staffLoansReviewed           StaffLoan[]                  @relation("StaffLoanReviewer")
  staffLoansDisbursed          StaffLoan[]                  @relation("StaffLoanDisbursing")
  staffLoanPaymentsRecorded    StaffLoanPayment[]           @relation("StaffPaymentRecorder")
  staffLoanPaymentsVerified    StaffLoanPayment[]           @relation("StaffPaymentVerifier")
  staffLoanReversalsApproved   StaffLoanReversal[]          @relation("ReversalApprover")
  staffLoanAdjustmentsApproved StaffLoanAdjustment[]        @relation("AdjustmentApprover")
  staffLoanApprovalsGiven      StaffLoanApproval[]          @relation("StaffLoanApprovalDecision")
  resourceOwnerships           ResourceOwnership[]          @relation("ResourceOwner")
  ownershipAssignments         ResourceOwnership[]          @relation("OwnershipAssigner")
  delegationsAsFrom            ResourceDelegation[]         @relation("Delegator")
  delegationsAsTo              ResourceDelegation[]         @relation("Delegate")
  delegationsCreated           ResourceDelegation[]         @relation("DelegationCreator")
  offboardingCases             OffboardingCase[]            @relation("OffboardingEmployee")
  offboardingsInitiated        OffboardingCase[]            @relation("OffboardingInitiator")
  itAccessRevocations          OffboardingCase[]            @relation("ITAccessRevoker")
  financeClearances            OffboardingCase[]            @relation("FinanceClearer")
  assetClearances              OffboardingCase[]            @relation("AssetClearer")
  hrClearances                 OffboardingCase[]            @relation("HRClearer")
  exitInterviews               OffboardingCase[]            @relation("ExitInterviewer")
  offboardingsCompleted        OffboardingCase[]            @relation("OffboardingCompleter")
  approvalPoliciesCreated      ApprovalPolicy[]             @relation("PolicyCreator")

  @@unique([email, deletedAt])
  @@unique([username, deletedAt])
  @@unique([phone, deletedAt])
  @@index([email])
  @@index([username])
  @@index([employeeId])
  @@index([status])
  @@index([departmentId])
  @@index([branchId])
  @@index([supervisorId])
  @@index([deletedAt])
  @@map("users")
}

model UserBranch {
  id           String    @id @default(uuid()) @db.VarChar(36)
  userId       String    @db.VarChar(36)
  branchId     String    @db.VarChar(36)
  canViewLoans Boolean   @default(false) // Location-based permission for viewing loan applications
  grantedById  String?   @db.VarChar(36) // Admin who granted this permission
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime? // When permission was revoked
  createdAt    DateTime  @default(now())
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([canViewLoans])
  @@map("user_branches")
}

model UserRole {
  id           String    @id @db.VarChar(36)
  userId       String    @db.VarChar(36)
  roleId       String    @db.VarChar(36)
  assignedAt   DateTime  @default(now())
  assignedById String?   @db.VarChar(36)
  expiresAt    DateTime?
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  id           String     @id @default(uuid()) @db.VarChar(36)
  userId       String     @db.VarChar(36)
  permissionId String     @db.VarChar(36)
  granted      Boolean    @default(true)
  reason       String?    @db.VarChar(500)
  assignedAt   DateTime   @default(now())
  assignedById String?    @db.VarChar(36)
  expiresAt    DateTime?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model OfficerTarget {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  userId               String   @db.VarChar(36)
  targetMonth          DateTime @db.Date // First day of the target month
  disbursementTarget   Decimal  @default(0) @db.Decimal(15, 2) // Target disbursement amount
  customerTarget       Int      @default(0) // Target number of new customers
  disbursementAchieved Decimal  @default(0) @db.Decimal(15, 2) // Actual disbursement amount
  customerAchieved     Int      @default(0) // Actual number of customers registered
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          String?  @db.VarChar(36)

  user User @relation("OfficerTargets", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetMonth])
  @@index([userId])
  @@index([targetMonth])
  @@map("officer_targets")
}

model Token {
  id          String    @id @default(uuid()) @db.VarChar(36)
  userId      String    @db.VarChar(36)
  type        TokenType
  token       String    @unique @db.VarChar(512)
  hashedToken String    @db.VarChar(255)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([hashedToken])
  @@index([expiresAt])
  @@map("tokens")
}

model Setting {
  id              String       @id @default(uuid()) @db.VarChar(36)
  key             String       @db.VarChar(100)
  value           String?      @db.Text
  defaultValue    String?      @db.Text
  type            SettingType  @default(STRING)
  scope           SettingScope @default(SYSTEM)
  branchId        String?      @db.VarChar(36)
  label           String       @db.VarChar(150)
  description     String?      @db.VarChar(500)
  group           String       @db.VarChar(50)
  isPublic        Boolean      @default(false)
  isReadonly      Boolean      @default(false)
  isEncrypted     Boolean      @default(false)
  sortOrder       Int          @default(0)
  validationRules String?      @db.LongText
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  updatedById     String?      @db.VarChar(36)
  branch          Branch?      @relation(fields: [branchId], references: [id])

  @@unique([key, scope, branchId])
  @@index([key])
  @@index([scope])
  @@index([group])
  @@index([branchId])
  @@map("settings")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.VarChar(36)
  userId        String?     @db.VarChar(36)
  userEmail     String?     @db.VarChar(150)
  userFullName  String?     @db.VarChar(200)
  action        AuditAction
  module        String      @db.VarChar(50)
  subModule     String?     @db.VarChar(50)
  entityId      String?     @db.VarChar(36)
  entityType    String?     @db.VarChar(100)
  description   String?     @db.VarChar(1000)
  oldValues     String?     @db.LongText
  newValues     String?     @db.LongText
  changedFields String?     @db.LongText
  ipAddress     String?     @db.VarChar(45)
  userAgent     String?     @db.VarChar(500)
  browser       String?     @db.VarChar(100)
  os            String?     @db.VarChar(100)
  device        String?     @db.VarChar(100)
  branchId      String?     @db.VarChar(36)
  requestId     String?     @db.VarChar(36)
  duration      Int?
  statusCode    Int?
  isSuccess     Boolean     @default(true)
  errorMessage  String?     @db.VarChar(1000)
  metadata      String?     @db.LongText
  createdAt     DateTime    @default(now())
  branch        Branch?     @relation(fields: [branchId], references: [id])
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityId])
  @@index([entityType])
  @@index([branchId])
  @@index([createdAt])
  @@index([isSuccess])
  @@map("audit_logs")
}

model Widget {
  id                 String                @id @default(uuid()) @db.VarChar(36)
  code               String                @unique @db.VarChar(50)
  name               String                @db.VarChar(100)
  description        String?               @db.VarChar(500)
  type               WidgetType
  size               WidgetSize            @default(MEDIUM)
  component          String                @db.VarChar(100)
  dataEndpoint       String?               @db.VarChar(255)
  refreshInterval    Int?
  requiredPermission String?               @db.VarChar(100)
  defaultConfig      String?               @db.LongText
  isSystem           Boolean               @default(false)
  isActive           Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  layoutItems        DashboardLayoutItem[]

  @@index([code])
  @@index([isActive])
  @@map("widgets")
}

model DashboardLayout {
  id        String                @id @default(uuid()) @db.VarChar(36)
  userId    String                @db.VarChar(36)
  name      String                @db.VarChar(100)
  isDefault Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  items     DashboardLayoutItem[]
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dashboard_layouts")
}

model DashboardLayoutItem {
  id        String          @id @default(uuid()) @db.VarChar(36)
  layoutId  String          @db.VarChar(36)
  widgetId  String          @db.VarChar(36)
  posX      Int             @default(0)
  posY      Int             @default(0)
  width     Int             @default(2)
  height    Int             @default(1)
  config    String?         @db.LongText
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  layout    DashboardLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  widget    Widget          @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([layoutId, widgetId])
  @@index([layoutId])
  @@index([widgetId])
  @@map("dashboard_layout_items")
}

model NotificationTemplate {
  id        String              @id @default(uuid()) @db.VarChar(36)
  code      String              @unique @db.VarChar(100)
  name      String              @db.VarChar(150)
  event     String              @db.VarChar(100)
  channel   NotificationChannel
  subject   String?             @db.VarChar(255)
  bodyHtml  String?             @db.LongText
  bodyText  String?             @db.Text
  variables String?             @db.LongText
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([event])
  @@index([channel])
  @@map("notification_templates")
}

model NotificationLog {
  id            String              @id @default(uuid()) @db.VarChar(36)
  recipientId   String?             @db.VarChar(36)
  recipientRef  String?             @db.VarChar(200)
  channel       NotificationChannel
  templateCode  String?             @db.VarChar(100)
  event         String?             @db.VarChar(100)
  subject       String?             @db.VarChar(255)
  body          String?             @db.Text
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failureReason String?             @db.VarChar(500)
  metadata      String?             @db.LongText
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([recipientId])
  @@index([channel])
  @@index([status])
  @@index([event])
  @@map("notification_logs")
}

model NotificationPreference {
  id        String              @id @default(uuid()) @db.VarChar(36)
  userId    String              @db.VarChar(36)
  event     String              @db.VarChar(100)
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event, channel])
  @@index([userId])
  @@index([event])
  @@map("notification_preferences")
}

model FormTemplate {
  id          String           @id @default(uuid()) @db.VarChar(36)
  entityType  FormEntityType
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(150)
  description String?          @db.VarChar(500)
  version     Int              @default(1)
  isActive    Boolean          @default(true)
  isDefault   Boolean          @default(false)
  metadata    String?          @db.LongText
  createdById String?          @db.VarChar(36)
  updatedById String?          @db.VarChar(36)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  sections    FormSection[]
  submissions FormSubmission[]

  @@index([entityType])
  @@index([isActive])
  @@index([deletedAt])
  @@map("form_templates")
}

model FormSection {
  id             String       @id @default(uuid()) @db.VarChar(36)
  formTemplateId String       @db.VarChar(36)
  title          String       @db.VarChar(150)
  description    String?      @db.VarChar(500)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  fields         FormField[]
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@index([formTemplateId])
  @@index([sortOrder])
  @@map("form_sections")
}

model FormField {
  id             String           @id @default(uuid()) @db.VarChar(36)
  sectionId      String           @db.VarChar(36)
  code           String           @db.VarChar(100)
  label          String           @db.VarChar(150)
  type           FormFieldType
  placeholder    String?          @db.VarChar(200)
  helpText       String?          @db.VarChar(500)
  isRequired     Boolean          @default(false)
  defaultValue   String?          @db.LongText
  options        String?          @db.LongText
  validation     String?          @db.LongText
  visibilityRule String?          @db.LongText
  sortOrder      Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  values         FormFieldValue[]
  section        FormSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, code])
  @@index([sectionId])
  @@index([sortOrder])
  @@map("form_fields")
}

model FormSubmission {
  id             String           @id @default(uuid()) @db.VarChar(36)
  formTemplateId String           @db.VarChar(36)
  entityType     FormEntityType
  entityId       String           @db.VarChar(36)
  submittedById  String?          @db.VarChar(36)
  submittedAt    DateTime         @default(now())
  isComplete     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  values         FormFieldValue[]
  formTemplate   FormTemplate     @relation(fields: [formTemplateId], references: [id])

  @@index([formTemplateId])
  @@index([entityType, entityId])
  @@map("form_submissions")
}

model FormFieldValue {
  id           String         @id @default(uuid()) @db.VarChar(36)
  submissionId String         @db.VarChar(36)
  fieldId      String         @db.VarChar(36)
  value        String?        @db.LongText
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  field        FormField      @relation(fields: [fieldId], references: [id])
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@index([submissionId])
  @@index([fieldId])
  @@map("form_field_values")
}

model DocumentType {
  id                      String                           @id @default(uuid()) @db.VarChar(36)
  code                    String                           @unique @db.VarChar(50)
  name                    String                           @db.VarChar(150)
  description             String?                          @db.VarChar(500)
  appliesTo               CustomerType?
  isRequiredDefault       Boolean                          @default(false)
  expiryApplicable        Boolean                          @default(false)
  allowedMimeTypes        String?                          @db.LongText
  sortOrder               Int                              @default(0)
  isActive                Boolean                          @default(true)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  deletedAt               DateTime?
  documents               CustomerDocument[]
  loanProductRequirements LoanProductDocumentRequirement[]

  @@index([isActive])
  @@map("document_types")
}

model Customer {
  id                               String             @id @default(uuid()) @db.VarChar(36)
  customerNumber                   String             @unique @db.VarChar(20)
  type                             CustomerType       @default(INDIVIDUAL)
  status                           CustomerStatus     @default(PROSPECT)
  firstName                        String             @db.VarChar(100)
