  MATERNITY_LEAVE
  EMERGENCY_LEAVE
  TEMPORARY_REASSIGNMENT
  TRAINING_PERIOD
  EMPLOYEE_EXITING
}

enum DelegationStatus {
  PENDING_ACCEPTANCE
  ACTIVE
  EXPIRED
  REJECTED
  REVOKED
}

enum OffboardingStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClearanceStatus {
  PENDING
  IN_PROGRESS
  CLEARED
  CLEARED_WITH_CONDITIONS
  NOT_APPLICABLE
  BLOCKED
}
