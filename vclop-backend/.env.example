# =============================================================================
# VCLOP Backend — Environment Variables Template
# Copy this file to .env and fill in all required values before starting.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | staging | test
PORT=3000
APP_NAME=VCLOP
DEBUG=false

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>"

# ── Auth / JWT (REQUIRED in production) ──────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=

# ── File Storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# S3 Configuration (only required when STORAGE_DRIVER=s3)
# AWS S3: Set bucket, region, and credentials
# Compatible services: DigitalOcean Spaces, MinIO, Wasabi, etc.
# For custom endpoints (e.g., DigitalOcean Spaces): Set S3_ENDPOINT
# Example: S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=                      # Your S3 bucket name
S3_REGION=ap-southeast-1        # AWS region (e.g., us-east-1, eu-west-1)
S3_ACCESS_KEY_ID=               # AWS Access Key ID or equivalent
S3_SECRET_ACCESS_KEY=           # AWS Secret Access Key or equivalent
S3_ENDPOINT=                    # (Optional) Custom S3-compatible endpoint
S3_PUBLIC_URL=                  # (Optional) Custom CDN URL for public access

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=VCLOP
MAIL_FROM_EMAIL=noreply@example.com

# ── Swagger ───────────────────────────────────────────────────────────────────
# SWAGGER_ENABLED=false

# ── Credit Bureau ─────────────────────────────────────────────────────────────
# Choose provider: MONO | DOJAH
# MONO: https://app.withmono.com (₦500-1000/report)
# DOJAH: https://app.dojah.io (₦800-1500/report) - More reliable
CREDIT_BUREAU_PROVIDER=DOJAH

# Mono API Key (if using MONO)
MONO_SECRET_KEY=

# Dojah Credentials (if using DOJAH)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
