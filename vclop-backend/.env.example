# =============================================================================
# VCLOP Backend — Environment Variables Template
# Copy this file to .env and fill in all required values before starting.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | staging | test
PORT=3000
APP_NAME=VCLOP
DEBUG=false

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>"

# ── Auth / JWT (REQUIRED in production) ──────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=60
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=

# ── File Storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# S3 (only required when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=VCLOP
MAIL_FROM_EMAIL=noreply@example.com

# ── Swagger ───────────────────────────────────────────────────────────────────
# SWAGGER_ENABLED=false
